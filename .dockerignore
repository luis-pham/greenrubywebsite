# Keep the build context to source code only. Runtime data is bind-mounted
# (docker-compose: ./storage, ./upload, ./.env), so it must never be baked in.

# Secrets
.env
.env.*
!.env.example
docker-compose*.yml*

# Runtime data (mounted at run time)
storage/
upload/
public/upload/
public/storage

# Built in the image (composer install / yarn run prod)
vendor/
node_modules/
public/hot
public/mix-manifest.json
public/assets/frontend/dist/

# Leftovers on the VPS (image exports, code copies, backups)
image/
source-code/
*.tar
*.tar.gz
*.sql
*.sql.gz
*.bak
*.bak-*
DEPLOYED_COMMIT

# VCS / tooling
.git/
.idea/
.vscode/
.DS_Store
.phpunit.result.cache
tests/
docs/
